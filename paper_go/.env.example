# paper_go configuration example
# Copy to .env and modify.

# LLM API key for AI summaries. If empty, paper_go uses built-in extractive summaries.
PAPER_GO_API_KEY=

# OpenAI-compatible API endpoint and model
PAPER_GO_LLM_BASE_URL=https://api.openai.com/v1
PAPER_GO_LLM_MODEL=gpt-4o-mini

# How many cited papers to process
PAPER_GO_MAX_REFERENCES=20

# Output directory
PAPER_GO_OUTPUT_DIR=paper_go_output

# HTTP timeout seconds
PAPER_GO_TIMEOUT=30

# Optional: email used by Unpaywall for legal OA PDF discovery
PAPER_GO_UNPAYWALL_EMAIL=
